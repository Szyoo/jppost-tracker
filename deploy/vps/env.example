# vultr-jp 部署用 .env 模板 —— 复制为 deploy/vps/.env 后逐项填写。
# ⚠️ 管理页对公网开放，下面【安全三件套】缺一不可，配好前不要启动。

# ===== 安全三件套（必填）=====
# 生成：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_USERNAME=admin
# 生成：python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('你的强密码'))"
ADMIN_PASSWORD_HASH=
# 经 Caddy HTTPS 访问，必须开
SESSION_COOKIE_SECURE=1

# ===== Bark 地址（内外分离）=====
# tracker 推送走容器网络内的 bark 服务
BARK_SERVER_INTERNAL=http://bark:8080
# 手机 Bark App 用的公网 HTTPS 地址（Caddy 反代）
BARK_SERVER_PUBLIC=https://bark.szyyw.xyz
# 兼容旧版，留空
BARK_SERVER=
BARK_HEALTH_PATH=/ping
BARK_HEALTH_TIMEOUT=15

# ===== 应用 =====
APP_PORT=6060
# Bark 由 compose 独立跑：禁用控制台的本地 Bark 子进程管理（隐藏启停卡片）
LOCAL_BARK_ENABLED=0
AUTO_START_BARK_SERVER=0
# Web 启动即自动运行追踪脚本，意外退出自动重启（默认 1，无需手动点启动）
AUTO_START_TRACKER=1
# VPS 不需要 Render 式保活，留空即禁用
PUBLIC_URL=

# ===== 会话/登录防护（可选，有默认值）=====
ADMIN_SESSION_HOURS=24
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=600
# 应用前面有几层受信反代（本部署 = Caddy 一层）。
# 配置后登录限流取 X-Forwarded-For 右数第 N 个值作为客户端 IP；
# 不配置（0）则只用直连地址，转发头一律不信
TRUSTED_PROXY_COUNT=1
