# 历史参考：当初追加到 vultr-jp 的 /opt/ingress/Caddyfile 的两个站点块。
# 现在 Caddyfile 在平台仓库 szyyw-platform 的 caddy/Caddyfile，推送即生效；不要再手改 VPS 上的文件。
# 前提：Cloudflare DNS 已添加 A 记录（灰云/DNS-only）：
#   jppost.szyyw.xyz → 167.179.76.194
#   bark.szyyw.xyz   → 167.179.76.194
# Caddy 会自动申请 Let's Encrypt 证书；reverse_proxy 原生透传 WebSocket，
# SocketIO 无需额外配置。

jppost.szyyw.xyz {
	reverse_proxy jppost-tracker:6060
}

bark.szyyw.xyz {
	reverse_proxy jppost-bark:8080
}
